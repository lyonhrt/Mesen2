@@ -0,0 +1,331 @@
+#include "Model.h"
+#include <iostream>
+#include "stb_image.h"
+
+Model::Model(const std::string& path)
+{
+    LoadModel(path);
+}
+
+void Model::Draw(Shader &shader)
+{
+    for(unsigned int i = 0; i < meshes.size(); i++)
+        meshes[i].Draw(shader);
+}
+
+bool Model::HasAnimations() const
+{
+    return !animations.empty();
+}
+
+int Model::GetAnimationCount() const
+{
+    return animations.size();
+}
+
+int Model::FindAnimation(const std::string& name) const
+{
+    for(int i = 0; i < animations.size(); i++) {
+        if(animations[i].Name == name) {
+            return i;
+        }
+    }
+    return -1; // Not found
+}
+
+void Model::PlayAnimation(int index, float speed, bool loop)
+{
+    if(index >= 0 && index < animations.size()) {
+        currentAnimation = index;
+        animationSpeed = speed;
+        animationLooping = loop;
+        animations[currentAnimation].Reset();
+    }
+}
+
+void Model::UpdateAnimations(float deltaTime)
+{
+    if(currentAnimation < 0 || currentAnimation >= animations.size()) {
+        return;
+    }
+    
+    Animation& animation = animations[currentAnimation];
+    
+    // Update animation time
+    animation.CurrentTime += deltaTime * animationSpeed;
+    
+    // Handle looping
+    if(animation.CurrentTime > animation.Duration) {
+        if(animationLooping) {
+            animation.CurrentTime = fmod(animation.CurrentTime, animation.Duration);
+        } else {
+            animation.CurrentTime = animation.Duration;
+            return; // Animation finished, don't update further
+        }
+    }
+    
+    // Apply the animation to the model
+    animation.Apply(scene);
+}
+
+void Model::LoadModel(const std::string& path)
+{
+    // Load model using Assimp
+    Assimp::Importer importer;
+    const aiScene* scene = importer.ReadFile(path, 
+        aiProcess_Triangulate | 
+        aiProcess_GenSmoothNormals | 
+        aiProcess_FlipUVs | 
+        aiProcess_CalcTangentSpace);
+    
+    // Check for errors
+    if(!scene || scene->mFlags & AI_SCENE_FLAGS_INCOMPLETE || !scene->mRootNode) {
+        std::cout << "ERROR::ASSIMP:: " << importer.GetErrorString() << std::endl;
+        return;
+    }
+    
+    // Store the directory path
+    this->directory = path.substr(0, path.find_last_of('/'));
+    
+    // Store the Assimp scene
+    this->scene = scene;
+    
+    // Process nodes
+    ProcessNode(scene->mRootNode, scene);
+    
+    // Load animations
+    LoadAnimations(scene);
+}
+
+void Model::ProcessNode(aiNode *node, const aiScene *scene)
+{
+    // Process meshes in this node
+    for(unsigned int i = 0; i < node->mNumMeshes; i++) {
+        aiMesh* mesh = scene->mMeshes[node->mMeshes[i]];
+        meshes.push_back(ProcessMesh(mesh, scene));
+    }
+    
+    // Process child nodes
+    for(unsigned int i = 0; i < node->mNumChildren; i++) {
+        ProcessNode(node->mChildren[i], scene);
+    }
+}
+
+Mesh Model::ProcessMesh(aiMesh *mesh, const aiScene *scene)
+{
+    std::vector<Vertex> vertices;
+    std::vector<unsigned int> indices;
+    std::vector<Texture> textures;
+    
+    // Process vertices
+    for(unsigned int i = 0; i < mesh->mNumVertices; i++) {
+        Vertex vertex;
+        
+        // Position
+        vertex.Position.x = mesh->mVertices[i].x;
+        vertex.Position.y = mesh->mVertices[i].y;
+        vertex.Position.z = mesh->mVertices[i].z;
+        
+        // Normal
+        if(mesh->HasNormals()) {
+            vertex.Normal.x = mesh->mNormals[i].x;
+            vertex.Normal.y = mesh->mNormals[i].y;
+            vertex.Normal.z = mesh->mNormals[i].z;
+        }
+        
+        // Texture coordinates
+        if(mesh->mTextureCoords[0]) {
+            vertex.TexCoords.x = mesh->mTextureCoords[0][i].x;
+            vertex.TexCoords.y = mesh->mTextureCoords[0][i].y;
+        } else {
+            vertex.TexCoords = glm::vec2(0.0f, 0.0f);
+        }
+        
+        vertices.push_back(vertex);
+    }
+    
+    // Process indices
+    for(unsigned int i = 0; i < mesh->mNumFaces; i++) {
+        aiFace face = mesh->mFaces[i];
+        for(unsigned int j = 0; j < face.mNumIndices; j++) {
+            indices.push_back(face.mIndices[j]);
+        }
+    }
+    
+    // Process materials/textures
+    if(mesh->mMaterialIndex >= 0) {
+        aiMaterial* material = scene->mMaterials[mesh->mMaterialIndex];
+        
+        // Diffuse maps
+        std::vector<Texture> diffuseMaps = LoadMaterialTextures(material, 
+                                                              aiTextureType_DIFFUSE, 
+                                                              "texture_diffuse");
+        textures.insert(textures.end(), diffuseMaps.begin(), diffuseMaps.end());
+        
+        // Specular maps
+        std::vector<Texture> specularMaps = LoadMaterialTextures(material, 
+                                                               aiTextureType_SPECULAR, 
+                                                               "texture_specular");
+        textures.insert(textures.end(), specularMaps.begin(), specularMaps.end());
+    }
+    
+    return Mesh(vertices, indices, textures);
+}
+
+std::vector<Texture> Model::LoadMaterialTextures(aiMaterial *mat, aiTextureType type, 
+                                               const std::string& typeName)
+{
+    std::vector<Texture> textures;
+    
+    for(unsigned int i = 0; i < mat->GetTextureCount(type); i++) {
+        aiString str;
+        mat->GetTexture(type, i, &str);
+        
+        // Check if texture was loaded before
+        bool skip = false;
+        for(unsigned int j = 0; j < textures_loaded.size(); j++) {
+            if(std::strcmp(textures_loaded[j].path.data(), str.C_Str()) == 0) {
+                textures.push_back(textures_loaded[j]);
+                skip = true;
+                break;
+            }
+        }
+        
+        if(!skip) {   // If texture hasn't been loaded already, load it
+            Texture texture;
+            texture.id = TextureFromFile(str.C_Str(), directory);
+            texture.type = typeName;
+            texture.path = str.C_Str();
+            textures.push_back(texture);
+            textures_loaded.push_back(texture); // Add to loaded textures
+        }
+    }
+    
+    return textures;
+}
+
+void Model::LoadAnimations(const aiScene *scene)
+{
+    // Load animations from the scene
+    for(unsigned int i = 0; i < scene->mNumAnimations; i++) {
+        aiAnimation* anim = scene->mAnimations[i];
+        
+        Animation animation;
+        animation.Name = anim->mName.C_Str();
+        animation.Duration = anim->mDuration;
+        animation.TicksPerSecond = anim->mTicksPerSecond;
+        
+        // Load animation channels (node animations)
+        for(unsigned int j = 0; j < anim->mNumChannels; j++) {
+            aiNodeAnim* nodeAnim = anim->mChannels[j];
+            
+            NodeAnimation nodeAnimation;
+            nodeAnimation.NodeName = nodeAnim->mNodeName.C_Str();
+            
+            // Position keyframes
+            for(unsigned int k = 0; k < nodeAnim->mNumPositionKeys; k++) {
+                aiVectorKey key = nodeAnim->mPositionKeys[k];
+                nodeAnimation.PositionKeys.push_back({
+                    key.mTime,
+                    glm::vec3(key.mValue.x, key.mValue.y, key.mValue.z)
+                });
+            }
+            
+            // Rotation keyframes
+            for(unsigned int k = 0; k < nodeAnim->mNumRotationKeys; k++) {
+                aiQuatKey key = nodeAnim->mRotationKeys[k];
+                nodeAnimation.RotationKeys.push_back({
+                    key.mTime,
+                    glm::quat(key.mValue.w, key.mValue.x, key.mValue.y, key.mValue.z)
+                });
+            }
+            
+            // Scale keyframes
+            for(unsigned int k = 0; k < nodeAnim->mNumScalingKeys; k++) {
+                aiVectorKey key = nodeAnim->mScalingKeys[k];
+                nodeAnimation.ScaleKeys.push_back({
+                    key.mTime,
+                    glm::vec3(key.mValue.x, key.mValue.y, key.mValue.z)
+                });
+            }
+            
+            animation.NodeAnimations.push_back(nodeAnimation);
+        }
+        
+        animations.push_back(animation);
+    }
+}
+
+void Model::Animation::Apply(const aiScene* scene)
+{
+    // Apply animation transformations to the model's nodes
+    // For each node in the animation
+    for(const auto& nodeAnim : NodeAnimations) {
+        // Find the node in the scene
+        aiNode* node = scene->mRootNode->FindNode(nodeAnim.NodeName.c_str());
+        if(!node) {
+            continue; // Skip if node not found
+        }
+        
+        // Calculate interpolated position
+        glm::vec3 position;
+        if(!nodeAnim.PositionKeys.empty()) {
+            // Find position keys to interpolate between
+            size_t nextPosIndex = 0;
+            for(size_t i = 0; i < nodeAnim.PositionKeys.size() - 1; i++) {
+                if(CurrentTime < nodeAnim.PositionKeys[i+1].Time) {
+                    nextPosIndex = i + 1;
+                    break;
+                }
+            }
+            size_t currentPosIndex = nextPosIndex > 0 ? nextPosIndex - 1 : 0;
+            
+            // Calculate interpolation factor
+            const auto& currentKey = nodeAnim.PositionKeys[currentPosIndex];
+            const auto& nextKey = nodeAnim.PositionKeys[nextPosIndex];
+            
+            double deltaTime = nextKey.Time - currentKey.Time;
+            float factor = deltaTime > 0 ? (CurrentTime - currentKey.Time) / deltaTime : 0.0f;
+            factor = glm::clamp(factor, 0.0f, 1.0f);
+            
+            // Interpolate position
+            position = glm::mix(currentKey.Position, nextKey.Position, factor);
+        }
+        
+        // Calculate interpolated rotation
+        glm::quat rotation;
+        if(!nodeAnim.RotationKeys.empty()) {
+            // Find rotation keys to interpolate between
+            size_t nextRotIndex = 0;
+            for(size_t i = 0; i < nodeAnim.RotationKeys.size() - 1; i++) {
+                if(CurrentTime < nodeAnim.RotationKeys[i+1].Time) {
+                    nextRotIndex = i + 1;
+                    break;
+                }
+            }
+            size_t currentRotIndex = nextRotIndex > 0 ? nextRotIndex - 1 : 0;
+            
+            // Calculate interpolation factor
+            const auto& currentKey = nodeAnim.RotationKeys[currentRotIndex];
+            const auto& nextKey = nodeAnim.RotationKeys[nextRotIndex];
+            
+            double deltaTime = nextKey.Time - currentKey.Time;
+            float factor = deltaTime > 0 ? (CurrentTime - currentKey.Time) / deltaTime : 0.0f;
+            factor = glm::clamp(factor, 0.0f, 1.0f);
+            
+            // Interpolate rotation (using SLERP)
+            rotation = glm::slerp(currentKey.Rotation, nextKey.Rotation, factor);
+        }
+        
+        // Calculate interpolated scale
+        glm::vec3 scale(1.0f);
+        if(!nodeAnim.ScaleKeys.empty()) {
+            // Find scale keys to interpolate between
+            size_t nextScaleIndex = 0;
+            for(size_t i = 0; i < nodeAnim.ScaleKeys.size() - 1; i++) {
+                if(CurrentTime < nodeAnim.ScaleKeys[i+1].Time) {
+                    nextScaleIndex = i + 1;
+                    break;
+                }
+            }
+            size_t currentScaleIndex = nextScaleIndex > 0 ? nextScaleIndex - 1 : 0;
+            
+            // Calculate interpolation factor
+            const auto& currentKey = nodeAnim.ScaleKeys[currentScaleIndex];
+            const auto& nextKey = nodeAnim.ScaleKeys[nextScaleIndex];
+            
+            double deltaTime = nextKey.Time - currentKey.Time;
+            float factor = deltaTime > 0 ? (CurrentTime - currentKey.Time) / deltaTime : 0.0f;
+            factor = glm::clamp(factor, 0.0f, 1.0f);
+            
+            // Interpolate scale
+            scale = glm::mix(currentKey.Scale, nextKey.Scale, factor);
+        }
+        
+        // Build transformation matrix and apply to node
+        glm::mat4 transformMat = glm::translate(glm::mat4(1.0f), position);
+        transformMat = transformMat * glm::mat4_cast(rotation);
+        transformMat = glm::scale(transformMat, scale);
+        
+        // Convert glm mat4 to aiMatrix4x4 and apply to node
+        aiMatrix4x4 aiTransform;
+        aiTransform.a1 = transformMat[0][0]; aiTransform.a2 = transformMat[0][1]; aiTransform.a3 = transformMat[0][2]; aiTransform.a4 = transformMat[0][3];
+        aiTransform.b1 = transformMat[1][0]; aiTransform.b2 = transformMat[1][1]; aiTransform.b3 = transformMat[1][2]; aiTransform.b4 = transformMat[1][3];
+        aiTransform.c1 = transformMat[2][0]; aiTransform.c2 = transformMat[2][1]; aiTransform.c3 = transformMat[2][2]; aiTransform.c4 = transformMat[2][3];
+        aiTransform.d1 = transformMat[3][0]; aiTransform.d2 = transformMat[3][1]; aiTransform.d3 = transformMat[3][2]; aiTransform.d4 = transformMat[3][3];
+        
+        node->mTransformation = aiTransform;
+    }
+}
+
+unsigned int Model::TextureFromFile(const char* path, const std::string& directory)
+{
+    std::string filename = std::string(path);
+    filename = directory + '/' + filename;
+    
+    unsigned int textureID;
+    glGenTextures(1, &textureID);
+    
+    int width, height, nrComponents;
+    unsigned char* data = stbi_load(filename.c_str(), &width, &height, &nrComponents, 0);
+    if(data) {
+        GLenum format;
+        if(nrComponents == 1)
+            format = GL_RED;
+        else if(nrComponents == 3)
+            format = GL_RGB;
+        else if(nrComponents == 4)
+            format = GL_RGBA;
+        
+        glBindTexture(GL_TEXTURE_2D, textureID);
+        glTexImage2D(GL_TEXTURE_2D, 0, format, width, height, 0, format, GL_UNSIGNED_BYTE, data);
+        glGenerateMipmap(GL_TEXTURE_2D);
+        
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        
+        stbi_image_free(data);
+    }
+    else {
+        std::cout << "Texture failed to load at path: " << path << std::endl;
+        stbi_image_free(data);
+    }
+    
+    return textureID;
+}
