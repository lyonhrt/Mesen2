+void HDPackLoader::Process3DBackground(const std::string& conditionName, 
+                                     const std::string& params, 
+                                     HdPackData& hdData)
+{
+    // Split the parameters by comma
+    std::vector<std::string> paramList;
+    std::stringstream ss(params);
+    std::string item;
+    while(std::getline(ss, item, ',')) {
+        paramList.push_back(item);
+    }
+    
+    if(paramList.size() < 1) {
+        return; // Need at least the model path
+    }
+    
+    HdPack3DBackground bg;
+    bg.ModelPath = paramList[0];
+    
+    // Parse scroll ratio - matching the existing 2D background format
+    if(paramList.size() >= 2) {
+        bg.ScrollRatio = std::stof(paramList[1]);
+    } else {
+        bg.ScrollRatio = 1.0f; // Default: scroll at same speed as foreground
+    }
+    
+    // Parse position if provided
+    if(paramList.size() >= 5) {
+        bg.Position.x = std::stof(paramList[2]);
+        bg.Position.y = std::stof(paramList[3]);
+        bg.Position.z = std::stof(paramList[4]);
+    } else {
+        // Default position
+        bg.Position.x = 0.0f;
+        bg.Position.y = 0.0f;
+        bg.Position.z = -10.0f;
+    }
+    
+    // Apply condition
+    if(!conditionName.empty()) {
+        for(const auto& cond : hdData.Conditions) {
+            if(cond.Name == conditionName) {
+                bg.Conditions.push_back(cond);
+                break;
+            }
+        }
+    }
+    
+    hdData.Backgrounds3D.push_back(bg);
+}
+
+void HDPackLoader::Process3DBackgroundLighting(const std::string& conditionName, 
+                                            const std::string& lightingPreset, 
+                                            HdPackData& hdData)
+{
+    // Find the last added background with matching condition
+    for(auto it = hdData.Backgrounds3D.rbegin(); it != hdData.Backgrounds3D.rend(); ++it) {
+        if(!it->Conditions.empty() && !conditionName.empty() && 
+           it->Conditions[0].Name == conditionName) {
+            it->LightingPreset = lightingPreset;
+            return;
+        }
+    }
+}
+
+void HDPackLoader::Process3DBackgroundAnimation(const std::string& conditionName, 
+                                             const std::string& animParams, 
+                                             HdPackData& hdData)
+{
+    // Split the animation parameters
+    std::vector<std::string> paramList;
+    std::stringstream ss(animParams);
+    std::string item;
+    while(std::getline(ss, item, ',')) {
+        paramList.push_back(item);
+    }
+    
+    if(paramList.size() < 1) {
+        return; // Need at least the animation name
+    }
+    
+    // Find the last added background with matching condition
+    for(auto it = hdData.Backgrounds3D.rbegin(); it != hdData.Backgrounds3D.rend(); ++it) {
+        if(!it->Conditions.empty() && !conditionName.empty() && 
+           it->Conditions[0].Name == conditionName) {
+            it->AnimationName = paramList[0];
+            
+            // Parse animation speed if provided
+            if(paramList.size() >= 2) {
+                it->AnimationSpeed = std::stof(paramList[1]);
+            } else {
+                it->AnimationSpeed = 1.0f;
+            }
+            
+            // Parse animation mode if provided
+            if(paramList.size() >= 3) {
+                it->AnimationMode = (paramList[2] == "loop") ? 
+                                   AnimationMode::Loop : AnimationMode::Once;
+            } else {
+                it->AnimationMode = AnimationMode::Loop;
+            }
+            
+            return;
+        }
+    }
+}
