+#pragma once
+
+#include <vector>
+#include <unordered_map>
+#include <memory>
+#include <string>
+#include "HdPackData.h"
+#include "Shader.h"
+#include "Camera.h"
+#include "Model.h"
+
+class EmulationState;
+
+class HDPack3DRenderer
+{
+public:
+    HDPack3DRenderer();
+    
+    void RenderBackgrounds(const std::vector<HdPack3DBackground>& backgrounds, 
+                          const EmulationState& state, float deltaTime);
+    
+private:
+    void InitShaders();
+    void InitCamera();
+    bool IsBackgroundActive(const HdPack3DBackground& bg, const EmulationState& state);
+    void UpdateCamera(const EmulationState& state);
+    void RenderBackground(const HdPack3DBackground& bg, 
+                         const EmulationState& state, 
+                         float deltaTime);
+    void SetupLighting(const HdPack3DBackground& bg);
+    void HandleAnimations(const HdPack3DBackground& bg, Model& model, float deltaTime);
+    
+    bool EvaluateCondition(const HdPackCondition& condition, const EmulationState& state);
+    
+    // Cache of loaded models to avoid reloading the same model multiple times
+    std::unordered_map<std::string, std::unique_ptr<Model>> modelCache;
+    
+    // Shader for rendering 3D backgrounds
+    Shader defaultShader;
+    
+    // Camera for rendering
+    Camera camera;
+    
+    // Screen dimensions
+    int screenWidth = 256 * 4; // Default NES resolution * scale
+    int screenHeight = 240 * 4;
+};
diff --git a/Core/HDPack3DRenderer.cpp b/Core/HDPack3DRenderer.cpp
new file mode 100644
index 0000000..dd9e0d3
--- /dev/null
+++ b/Core/HDPack3DRenderer.cpp
@@ -0,0 +1,280 @@
+#include "HDPack3DRenderer.h"
+#include "EmulationState.h"
+#include "glad/glad.h"
+#include "glm/glm.hpp"
+#include "glm/gtc/matrix_transform.hpp"
+#include "glm/gtc/type_ptr.hpp"
+
+HDPack3DRenderer::HDPack3DRenderer()
+{
+    InitShaders();
+    InitCamera();
+}
+
+void HDPack3DRenderer::RenderBackgrounds(const std::vector<HdPack3DBackground>& backgrounds, 
+                                        const EmulationState& state, float deltaTime)
+{
+    // Update camera position based on game scroll position
+    UpdateCamera(state);
+    
+    // Render each active background
+    for(const auto& bg : backgrounds) {
+        if(IsBackgroundActive(bg, state)) {
+            RenderBackground(bg, state, deltaTime);
+        }
+    }
+}
+
+void HDPack3DRenderer::InitShaders()
+{
+    // Initialize default shader for 3D background rendering
+    const char* vertexShaderSource = R"(
+        #version 330 core
+        layout (location = 0) in vec3 aPos;
+        layout (location = 1) in vec3 aNormal;
+        layout (location = 2) in vec2 aTexCoord;
+        
+        out vec3 FragPos;
+        out vec3 Normal;
+        out vec2 TexCoord;
+        
+        uniform mat4 model;
+        uniform mat4 view;
+        uniform mat4 projection;
+        
+        void main() {
+            FragPos = vec3(model * vec4(aPos, 1.0));
+            Normal = mat3(transpose(inverse(model))) * aNormal;
+            TexCoord = aTexCoord;
+            
+            gl_Position = projection * view * model * vec4(aPos, 1.0);
+        }
+    )";
+    
+    const char* fragmentShaderSource = R"(
+        #version 330 core
+        out vec4 FragColor;
+        
+        in vec3 FragPos;
+        in vec3 Normal;
+        in vec2 TexCoord;
+        
+        uniform sampler2D texture_diffuse1;
+        
+        uniform bool useAdditionalLighting;
+        uniform vec3 ambientColor;
+        uniform float ambientIntensity;
+        
+        // For preset lighting
+        uniform vec3 lightPos;
+        uniform vec3 lightColor;
+        uniform float lightIntensity;
+        
+        void main() {
+            vec4 texColor = texture(texture_diffuse1, TexCoord);
+            
+            if(!useAdditionalLighting) {
+                // Use baked lighting from the texture
+                FragColor = texColor;
+            } 
+            else {
+                // Normal lighting calculation
+                vec3 norm = normalize(Normal);
+                vec3 lightDir = normalize(lightPos - FragPos);
+                
+                // Ambient
+                vec3 ambient = ambientColor * ambientIntensity;
+                
+                // Diffuse
+                float diff = max(dot(norm, lightDir), 0.0);
+                vec3 diffuse = lightColor * diff * lightIntensity;
+                
+                // Final color
+                vec3 result = (ambient + diffuse) * texColor.rgb;
+                
+                FragColor = vec4(result, texColor.a);
+            }
+        }
+    )";
+    
+    // Compile and link shaders
+    defaultShader.Compile(vertexShaderSource, fragmentShaderSource);
+}
+
+void HDPack3DRenderer::InitCamera()
+{
+    // Initialize the camera used for rendering 3D backgrounds
+    camera.Position = glm::vec3(0.0f, 0.0f, 0.0f);
+    camera.Front = glm::vec3(0.0f, 0.0f, -1.0f);
+    camera.Up = glm::vec3(0.0f, 1.0f, 0.0f);
+}
+
+bool HDPack3DRenderer::IsBackgroundActive(const HdPack3DBackground& bg, const EmulationState& state)
+{
+    // Check if any conditions are met for this background
+    if(bg.Conditions.empty()) {
+        return true; // No conditions = always active
+    }
+    
+    for(const auto& condition : bg.Conditions) {
+        if(EvaluateCondition(condition, state)) {
+            return true;
+        }
+    }
+    
+    return false;
+}
+
+bool HDPack3DRenderer::EvaluateCondition(const HdPackCondition& condition, const EmulationState& state)
+{
+    // Implementation to evaluate conditions based on game state
+    // This would match the existing condition evaluation logic used for 2D backgrounds
+    
+    // Placeholder implementation
+    uint32_t memoryValue = state.GetMemoryValue(condition.MemoryAddress);
+    
+    switch(condition.ComparisonType) {
+        case HdPackConditionComparisonType::Equal:
+            return memoryValue == condition.ValueToCompare;
+        case HdPackConditionComparisonType::NotEqual:
+            return memoryValue != condition.ValueToCompare;
+        case HdPackConditionComparisonType::LessThan:
+            return memoryValue < condition.ValueToCompare;
+        case HdPackConditionComparisonType::GreaterThan:
+            return memoryValue > condition.ValueToCompare;
+        case HdPackConditionComparisonType::LessThanOrEqual:
+            return memoryValue <= condition.ValueToCompare;
+        case HdPackConditionComparisonType::GreaterThanOrEqual:
+            return memoryValue >= condition.ValueToCompare;
+    }
+    
+    return false;
+}
+
+void HDPack3DRenderer::UpdateCamera(const EmulationState& state)
+{
+    // Update camera position based on game scroll position
+    float scrollX = state.GetScrollX();
+    float scrollY = state.GetScrollY();
+    
+    camera.Position.x = scrollX * 0.01f; // Scale factor to convert from game units
+    camera.Position.y = scrollY * 0.01f;
+}
+
+void HDPack3DRenderer::RenderBackground(const HdPack3DBackground& bg, 
+                                       const EmulationState& state, 
+                                       float deltaTime)
+{
+    // Load the model if not already loaded
+    if(!modelCache.contains(bg.ModelPath)) {
+        modelCache[bg.ModelPath] = std::make_unique<Model>(bg.ModelPath);
+    }
+    
+    Model& model = *modelCache[bg.ModelPath];
+    
+    // Set up projection and view matrices
+    glm::mat4 projection = glm::perspective(glm::radians(45.0f), 
+                                           (float)screenWidth / (float)screenHeight, 
+                                           0.1f, 100.0f);
+    glm::mat4 view = camera.GetViewMatrix();
+    
+    // Set up model matrix based on background properties
+    glm::mat4 modelMatrix = glm::mat4(1.0f);
+    
+    // Apply game scroll position based on scroll ratio
+    float scrollX = state.GetScrollX() * bg.ScrollRatio;
+    float scrollY = state.GetScrollY() * bg.ScrollRatio;
+    
+    // Position the model
+    modelMatrix = glm::translate(modelMatrix, 
+                                glm::vec3(bg.Position.x - scrollX * 0.01f, 
+                                        bg.Position.y - scrollY * 0.01f, 
+                                        bg.Position.z));
+    
+    // Scale the model
+    modelMatrix = glm::scale(modelMatrix, 
+                            glm::vec3(bg.Scale.x, bg.Scale.y, bg.Scale.z));
+    
+    // Set up shader parameters
+    defaultShader.Use();
+    defaultShader.SetMatrix4("projection", projection);
+    defaultShader.SetMatrix4("view", view);
+    defaultShader.SetMatrix4("model", modelMatrix);
+    
+    // Configure lighting
+    SetupLighting(bg);
+    
+    // Handle animations
+    HandleAnimations(bg, model, deltaTime);
+    
+    // Render the model
+    model.Draw(defaultShader);
+}
+
+void HDPack3DRenderer::SetupLighting(const HdPack3DBackground& bg)
+{
+    bool useAdditionalLighting = bg.LightingPreset.has_value();
+    defaultShader.SetBool("useAdditionalLighting", useAdditionalLighting);
+    
+    // If not using additional lighting, the shader will just use the texture as-is
+    if(!useAdditionalLighting) {
+        return;
+    }
+    
+    // Set default ambient values
+    glm::vec3 ambientColor(0.5f, 0.5f, 0.6f);
+    float ambientIntensity = 0.5f;
+    
+    // Configure preset lighting based on the specified preset
+    glm::vec3 lightPos;
+    glm::vec3 lightColor(1.0f, 1.0f, 1.0f);
+    float lightIntensity = 1.0f;
+    
+    if(bg.LightingPreset == "top") {
+        // Top lighting preset
+        lightPos = glm::vec3(0.0f, 8.0f, 0.0f);
+        lightColor = glm::vec3(1.0f, 0.98f, 0.95f); // Slightly warm
+        lightIntensity = 1.2f;
+        ambientIntensity = 0.5f;
+    }
+    else if(bg.LightingPreset == "front") {
+        // Front lighting preset
+        lightPos = glm::vec3(0.0f, 1.0f, 8.0f);
+        lightColor = glm::vec3(1.0f, 0.9f, 0.8f); // Warmer
+        lightIntensity = 1.5f;
+        ambientIntensity = 0.3f;
+    }
+    else if(bg.LightingPreset == "bottom") {
+        // Bottom lighting preset
+        lightPos = glm::vec3(0.0f, -5.0f, 2.0f);
+        lightColor = glm::vec3(0.9f, 0.7f, 1.0f); // Slightly purple
+        lightIntensity = 1.8f;
+        ambientIntensity = 0.2f;
+    }
+    else {
+        // Custom or unrecognized preset, use default values
+        lightPos = glm::vec3(0.0f, 5.0f, 5.0f);
+    }
+    
+    // Set the lighting parameters in the shader
+    defaultShader.SetVector3("ambientColor", ambientColor);
+    defaultShader.SetFloat("ambientIntensity", ambientIntensity);
+    defaultShader.SetVector3("lightPos", lightPos);
+    defaultShader.SetVector3("lightColor", lightColor);
+    defaultShader.SetFloat("lightIntensity", lightIntensity);
+}
+
+void HDPack3DRenderer::HandleAnimations(const HdPack3DBackground& bg, Model& model, float deltaTime)
+{
+    if(!model.HasAnimations()) {
+        return; // No animations to process
+    }
+    
+    // If no specific animation is set but the model has animations, use the first one
+    if(!bg.AnimationName.has_value() && model.GetAnimationCount() > 0) {
+        model.PlayAnimation(0, 1.0f); // Default speed
+    }
+    // If animation name is specified, find and play it
+    else if(bg.AnimationName.has_value()) {
+        int animIndex = model.FindAnimation(bg.AnimationName.value());
+        if(animIndex >= 0) {
+            float speed = bg.AnimationSpeed.value_or(1.0f);
+            bool loop = !bg.AnimationMode.has_value() || 
+                       bg.AnimationMode.value() == AnimationMode::Loop;
+            
+            model.PlayAnimation(animIndex, speed, loop);
+        }
+    }
+    
+    // Update animation state
+    model.UpdateAnimations(deltaTime);
+}
