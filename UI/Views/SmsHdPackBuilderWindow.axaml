<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Mesen.ViewModels"
        xmlns:c="using:Mesen.Controls"
        xmlns:l="using:Mesen.Localization"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="350"
        x:Class="Mesen.Views.SmsHdPackBuilderWindow"
        x:DataType="vm:SmsHdPackBuilderViewModel"
        Title="{l:Translate wndTitle}"
        Width="500" Height="350"
        Icon="/Assets/HdPack.png"
        WindowStartupLocation="CenterOwner">

  <Design.DataContext>
    <vm:SmsHdPackBuilderViewModel/>
  </Design.DataContext>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="15">
        
        <!-- Save Location -->
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="Save to:" VerticalAlignment="Center" Margin="0,0,5,0" />
          <TextBox Grid.Column="1" Text="{Binding SaveFolder}" IsReadOnly="True" />
        </Grid>

        <!-- Scale & Filter Options -->
        <c:GroupBox Header="Scale &amp; Filter Options">
          <StackPanel Spacing="10">
            
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              
              <TextBlock Grid.Column="0" 
                         Text="Filter:" 
                         VerticalAlignment="Center" 
                         Margin="0,0,10,0" />
              
              <ComboBox Grid.Column="1" 
                        ItemsSource="{Binding Filters}"
                        SelectedItem="{Binding SelectedFilter}"
                        IsEnabled="{Binding IsFilterEnabled}" />
            </Grid>

          </StackPanel>
        </c:GroupBox>

        <!-- Recording Options -->
        <c:GroupBox Header="Recording Settings">
          <StackPanel Spacing="10">
            
            <CheckBox Content="Group blank tiles" 
                      IsChecked="{Binding Config.GroupBlankTiles}"
                      IsEnabled="{Binding !IsRecording}" />
            
            <CheckBox Content="Sort pages by usage frequency" 
                      IsChecked="{Binding Config.SortByUsageFrequency}"
                      IsEnabled="{Binding !IsRecording}" />
            
            <CheckBox Content="Draw tile borders on PNG sheets" 
                      IsChecked="{Binding Config.DrawTileBorders}"
                      IsEnabled="{Binding !IsRecording}" />

          </StackPanel>
        </c:GroupBox>


      </StackPanel>
    </ScrollViewer>

    <!-- Footer - NES style with Open Folder and Start/Stop toggle -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
      <Button Grid.Column="0"
              Content="Open Save Folder" 
              Click="OpenFolder_Click"
              IsEnabled="{Binding IsOpenFolderEnabled}" />
      
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
        <Button Content="Start Recording" 
                Click="StartRecording_Click"
                IsVisible="{Binding !IsRecording}" />
        <Button Content="Stop Recording" 
                Click="StopRecording_Click"
                IsVisible="{Binding IsRecording}" />
      </StackPanel>
    </Grid>

  </Grid>
</Window>
